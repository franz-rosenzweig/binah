<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Binah app settings"
            android:textAppearance="?android:attr/textAppearanceLarge" />
        <TextView
            style="@style/Settings.Note"
            android:text="Your weekly goal and how Claude talks to you are in Binah's own Settings, in the app." />

        <!-- the address -->
        <TextView style="@style/Settings.Heading" android:text="Binah's address" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <EditText
                android:id="@+id/base"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="https://binah.tiresia.xyz"
                android:importantForAutofill="no"
                android:inputType="textUri" />
            <Button
                android:id="@+id/useBase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Use" />
        </LinearLayout>
        <TextView
            android:id="@+id/baseNote"
            style="@style/Settings.Note"
            android:text="https://binah.tiresia.xyz. The app talks to Binah over https only (localhost aside, for testing), which the microphone needs too." />

        <!-- the token -->
        <TextView style="@style/Settings.Heading" android:text="This phone" />
        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:id="@+id/connect"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Connect this phone" />
            <Button
                android:id="@+id/forget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Forget the token" />
        </LinearLayout>
        <TextView
            style="@style/Settings.Note"
            android:text="The widget and Train on this use a device token, kept encrypted on this phone. Binah makes one by itself once you're signed in in the app; Connect makes a new one. Binah lists it under this phone's model." />

        <!-- the microphone -->
        <TextView style="@style/Settings.Heading" android:text="Microphone" />
        <TextView
            android:id="@+id/mic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium" />
        <Button
            android:id="@+id/allowMic"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Allow the microphone" />
        <TextView
            style="@style/Settings.Note"
            android:text="Just a Minute and the benchmark talk record your voice in the app and send it to your Binah server, which transcribes it. The screen stays on while you record." />
    </LinearLayout>
</ScrollView>
